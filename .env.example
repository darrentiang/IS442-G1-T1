# Discord group chat settings. Copy this file to .env and fill in the values.
# .env is git-ignored: never commit real tokens or secrets.
# Setup guide: Discord Developer Portal > your application (Bot and OAuth2 pages).

# Bot page > Reset Token (secret)
DISCORD_BOT_TOKEN=
# OAuth2 page > Client ID
DISCORD_CLIENT_ID=
# OAuth2 page > Reset Secret (secret)
DISCORD_CLIENT_SECRET=
# Discord: right-click the server icon > Copy Server ID (needs Developer Mode)
DISCORD_GUILD_ID=
# Must match OAuth2 page > Redirects exactly
DISCORD_REDIRECT_URI=http://localhost:8080/discord/callback
